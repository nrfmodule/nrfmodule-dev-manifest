#!/usr/bin/env bash
# nrfmodule pre-push hook: refuse to push to main. Merges go through a PR.
# Bypass for a deliberate release step: ALLOW_MAIN_PUSH=1 git push ...
set -u
[ "${ALLOW_MAIN_PUSH:-0}" = "1" ] && exit 0
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
		refs/heads/main|refs/heads/master)
			echo "[pre-push] refusing to push to $remote_ref. Open a PR. (ALLOW_MAIN_PUSH=1 to override)"
			status=1 ;;
	esac
done
exit $status
